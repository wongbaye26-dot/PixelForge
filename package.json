{
  "name": "pixel-forge",
  "version": "1.2.0",
  "private": true,
  "description": "Local AI batch image processing & export tool",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"tsx watch workers/server.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch workers/server.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "build:web": "VITE_API_BASE=http://127.0.0.1:3847/api VITE_WORKER_BASE=http://127.0.0.1:3847 vue-tsc --noEmit && VITE_API_BASE=http://127.0.0.1:3847/api VITE_WORKER_BASE=http://127.0.0.1:3847 vite build",
    "build:mac": "npm run build:worker && npm run build:web && electron-builder --mac",
    "build:win": "npm run build:worker && npm run build:web && electron-builder --win --x64",
    "electron:dev": "npm run build:worker && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "better-sqlite3": "^11.9.1",
    "chokidar": "^4.0.3",
    "naive-ui": "^2.41.0",
    "p-queue": "^8.1.0",
    "piscina": "^5.0.0",
    "pinia": "^3.0.2",
    "sharp": "^0.34.2",
    "vue": "^3.5.14",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.pixelforge.app",
    "productName": "PixelForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron-dist/**",
      "node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
